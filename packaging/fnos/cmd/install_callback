#!/bin/bash
#
# 安装文件应用「后」执行。应用文件此时已经就位。
#
# 把目录准备和密钥生成放在这里，而不是留给每次 start：
#   - 安装失败能立刻通过 TRIM_TEMP_LOGFILE 反馈给用户，而不是表现为"装好了但启动不了"
#   - cmd/main 里仍然保留同样的调用，因为文档要求脚本可重复执行，也为了兼容
#     手工恢复、跨版本升级等 install_callback 没跑过的场景
#
set -u

# shellcheck source=../app/lib/env.sh
. "${TRIM_APPDEST}/lib/env.sh"

pv_ensure_dirs

# 工作目录必须在这一趟定下来。wizard/install 收集的 $wizard_work_dir 只在安装期
# 以环境变量存在，start 时读不到，所以这里校验、创建、探测可写，再落盘到
# TRIM_PKGETC/workdir 供之后每次启动读取。任何一步不过就直接让安装失败，用户能在
# 应用中心看到具体原因，而不是"装好了但启动不了"。
if ! pv_persist_workdir; then
  exit 1
fi

if ! pv_ensure_secret; then
  pv_fail "无法生成 JWT 密钥（Python 运行时: ${PV_PYTHON}）。请确认运行时依赖已正确安装。"
  exit 1
fi

# 自定义工作目录已由 pv_persist_workdir 创建并验证过。默认的共享目录则由系统在安装
# 时创建并授予 ACL 权限，这里只验证，不创建——它没建出来说明资源声明有问题，替它
# mkdir 只会掩盖故障。
if [ "$PV_STORAGE_IS_CUSTOM" -eq 0 ]; then
  if [ -z "$PV_STORAGE_ROOT" ] || [ ! -d "$PV_STORAGE_ROOT" ]; then
    pv_fail "共享数据目录未创建成功: '${PV_STORAGE_ROOT}'"
    exit 1
  fi

  if ! pv_storage_writable; then
    pv_fail "共享数据目录不可写: ${PV_STORAGE_ROOT}（运行用户: ${TRIM_USERNAME:-?}）"
    exit 1
  fi
fi

pv_log "Install completed. runtime=${PV_RUNTIME_MODE} storage=${PV_STORAGE_ROOT} custom=${PV_STORAGE_IS_CUSTOM} etc=${TRIM_PKGETC} var=${TRIM_PKGVAR}"
exit 0
