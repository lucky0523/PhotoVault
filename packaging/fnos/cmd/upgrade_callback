#!/bin/bash
#
# 升级「后」执行。新版本的应用文件已就位。
#
# 与 install_callback 做同样的幂等准备，外加一次密钥位置迁移：早期版本把
# jwt_secret 放在 TRIM_PKGVAR，现在统一放 TRIM_PKGETC。不迁移的话升级后密钥会被
# 重新生成，所有已登录的手机端和 Web 端 token 会一起失效。
#
# 最后确认工作目录指针（data-share 下的 .workdir）还在。升级不该让管理员重新选
# 工作目录：uninstall_callback 在 TRIM_APP_STATUS=UPGRADE 时本就保留指针；这里兜底
# 处理指针已被退休成 .workdir.previous 的情况（旧版本的升级、或某个飞牛版本在卸载
# 阶段没报 UPGRADE），旧库校验有效才恢复，否则照常交给初始化向导。
#
set -u
# shellcheck source=../app/lib/env.sh
. "${TRIM_APPDEST}/lib/env.sh"
pv_ensure_dirs
pv_migrate_secret
if ! pv_ensure_secret; then
  pv_fail "升级后无法准备 JWT 密钥（Python 运行时: ${PV_PYTHON}）"
  exit 1
fi
MAIN="$(dirname "$0")/main"
if [ -s "${PV_DATA_SHARE}/.workdir" ]; then
  pv_log "Upgrade: work dir pointer present ($(head -n 1 "${PV_DATA_SHARE}/.workdir" 2>/dev/null | tr -d '\r'))"
# 直接调用、不放进 $(...)：结果通过 PV_RESTORE_CANDIDATE / PV_RESTORE_SKIP_REASON 传回。
elif pv_previous_workdir_candidate; then
  # 服务端只在进程启动时解析一次照片和数据库的位置。若飞牛已经先把新版本拉起来了，
  # 它会停在「未初始化」状态，所以恢复指针前后要重启一次；没在跑就不碰它。
  was_running=0
  if [ -x "$MAIN" ] && "$MAIN" status >/dev/null 2>&1; then
    was_running=1
    "$MAIN" stop >/dev/null 2>&1
  fi
  if pv_restore_previous_workdir; then
    pv_log "Upgrade: restored work dir pointer from .workdir.previous (${PV_RESTORE_CANDIDATE})"
  else
    pv_log "WARN: Upgrade: could not restore ${PV_DATA_SHARE}/.workdir.previous; setup wizard will run"
  fi
  if [ "$was_running" -eq 1 ] && ! "$MAIN" start >/dev/null 2>&1; then
    # main 已经把用户可见的原因写进了 TRIM_TEMP_LOGFILE；升级本身不算失败，飞牛会自己再拉起应用。
    pv_log "WARN: Upgrade: restart after restoring the work dir pointer failed."
  fi
else
  pv_log "Upgrade: not restoring work dir pointer (${PV_RESTORE_SKIP_REASON:-unknown}); setup wizard will run"
fi
pv_log "Upgrade completed: ${TRIM_OLD_APPVER:-?} -> ${TRIM_APPVER:-?} (runtime=${PV_RUNTIME_MODE})"
exit 0
