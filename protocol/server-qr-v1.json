    {"input": "10.0.0.5", "canonical": "http://10.0.0.5"},
    {"input": "http://photo_vault:8000", "canonical": "http://photo_vault:8000"},
    {"input": "http://xn--fsqu00a.com", "canonical": "http://xn--fsqu00a.com"},
    {"input": "http://[1:0:0:2:0:0:3:4]", "canonical": "http://[1::2:0:0:3:4]"},
    {"input": "http://[1:0:2:3:4:5:6:7]", "canonical": "http://[1:0:2:3:4:5:6:7]"},
    {"input": "http://[2001:DB8:0:0:0:0:0:0001]:443", "canonical": "http://[2001:db8::1]:443"},
    {"input": "http://[2001:0db8::1]", "canonical": "http://[2001:db8::1]"},
    {"input": "http://[2001:0:4136:e378:8000:63bf:3fff:fdd2]", "canonical": "http://[2001:0:4136:e378:8000:63bf:3fff:fdd2]"},
    {"input": "http://[fd00::10]:99999", "error": "BAD_PORT"},
    {"input": "", "canonical": null},
    {"input": "   ", "canonical": null},
    {"input": "ftp://a", "error": "BAD_SCHEME"},
    {"input": "photovault://connect?v=1", "error": "BAD_SCHEME"},
    {"input": "{\"v\":1,\"public\":\"https://a\"}", "error": "BAD_SCHEME"},
    {"input": "http://a:70000", "error": "BAD_PORT"},
    {"input": "a:0", "error": "BAD_PORT"},
    {"input": "http://a:123456", "error": "BAD_PORT"},
    {"input": "http://", "error": "INVALID"},
    {"input": "http://a b", "error": "INVALID"},
    {"input": "http://a:b", "error": "INVALID"},
    {"input": "http://a..b", "error": "INVALID"},
    {"input": "http://[fd00::1%25eth0]", "error": "INVALID"},
    {"input": "http://u@a:70000", "error": "INVALID"},
