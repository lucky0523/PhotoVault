    {"input": "WIFI:S:home;T:WPA;P:secret;;", "error": "INVALID"},
    {"input": "http://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.com", "error": "INVALID"},
    {"input": "http://a/path", "error": "HAS_EXTRA"},
    {"input": "http://u:p@a", "error": "HAS_EXTRA"},
    {"input": "http://a?x=1", "error": "HAS_EXTRA"},
    {"input": "http://a#frag", "error": "HAS_EXTRA"},
    {"input": "https://photos.example.com/#pv=1", "error": "HAS_EXTRA"},
    {"input": "mailto:a@b.com", "error": "HAS_EXTRA"},
    {"input": "http://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "error": "TOO_LONG"}
  ],
